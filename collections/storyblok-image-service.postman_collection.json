          "name": "Resize an image to specified dimensions",
          "request": {
            "name": "Resize an image to specified dimensions",
            "description": {
              "content": "Returns the image resized to the specified width and height in pixels. If only width is provided (e.g., 500x0), the height is scaled proportionally. If only height is provided (e.g., 0x300), the width is scaled proportionally. Both dimensions set to 0 returns the original size.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                ":asset_path",
                "m",
                "{{width}}x{{height}}"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
