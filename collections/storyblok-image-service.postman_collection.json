      },
      "item": [
        {
          "id": "088e6b96-b8f8-4ea7-8739-3f8c8e1c8981",
          "name": "Retrieve original image with transformation routing enabled",
          "request": {
            "name": "Retrieve original image with transformation routing enabled",
            "description": {
              "content": "Returns the original image without any transformation. The /m/ path segment activates the Image Service transformation routing for all subsequent operations. Any further path segments after /m/ apply transformations such as resizing, cropping, and filter effects.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                ":asset_path",
                "m",
                ""
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": [
                {
                  "disabled": false,
                  "type": "any",
                  "value": "<string>",
                  "key": "asset_path",
                  "description": "(Required) The path portion of the original Storyblok asset CDN URL after the hostname. For example, if the asset URL is https://img2.storyblok.com/f/12345/1200x800/photo.jpg, the asset_path is f/12345/1200x800/photo.jpg."
                }
              ]
            },
            "header": [
              {
                "key": "Accept",
                "value": "image/*"
              }
