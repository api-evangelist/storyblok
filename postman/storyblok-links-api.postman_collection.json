      "name": "links",
      "item": [
        {
          "name": "List all links",
          "id": "27fc3503-939a-494a-a07e-e842c0fea6a7",
          "protocolProfileBehavior": {
            "disableBodyPruning": true
          },
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/links?token=<string>&version=published&starts_with=<string>&paginated=1&page=1&per_page=25&including_dates=1&cv=<integer>",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "links"
              ],
              "query": [
                {
                  "description": "(Required) The API access token for the space. Use the public token to access published content or the preview token to access draft content.",
                  "key": "token",
                  "value": "<string>"
                },
                {
                  "description": "Content version to retrieve. Use published to get published content (default) or draft to get the latest saved draft. The draft version requires the preview API token.",
                  "key": "version",
                  "value": "published"
                },
                {
                  "description": "Filter links by full_slug prefix to return only links in a specific folder.",
                  "key": "starts_with",
                  "value": "<string>"
                },
                {
                  "description": "Set to 1 to enable pagination on the links response. When enabled, use page and per_page parameters to control the result set.",
                  "key": "paginated",
                  "value": "1"
                },
                {
                  "description": "Page number for paginated results. Starts at 1. Requesting a page higher than the last available page returns an empty array.",
                  "key": "page",
                  "value": "1"
                },
                {
                  "description": "Number of items to return per page. Maximum is 100 for most endpoints.",
                  "key": "per_page",
                  "value": "25"
                },
                {
                  "description": "Set to 1 to include published_at, created_at, and updated_at timestamps in each link entry.",
                  "key": "including_dates",
                  "value": "1"
                },
                {
                  "description": "Cache version timestamp to bypass CDN caching.",
                  "key": "cv",
                  "value": "<integer>"
                }
              ]
            },
            "description": "Returns a flat or tree-structured map of all story URLs in the space. This endpoint is commonly used to generate navigation menus, breadcrumbs, and sitemaps. The response is keyed by story UUID and each entry contains the slug, name, and parent information."
