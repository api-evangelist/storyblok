          "name": "List all tags",
          "id": "2e35c2ab-b1af-4348-add4-5ec2a05631b2",
          "protocolProfileBehavior": {
            "disableBodyPruning": true
          },
          "request": {
            "method": "GET",
            "header": [
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "url": {
              "raw": "{{baseUrl}}/tags?token=<string>&starts_with=<string>&cv=<integer>",
              "host": [
                "{{baseUrl}}"
              ],
              "path": [
                "tags"
              ],
              "query": [
                {
                  "description": "(Required) The API access token for the space. Use the public token to access published content or the preview token to access draft content.",
                  "key": "token",
                  "value": "<string>"
                },
                {
                  "description": "Filter tags by prefix. Only tags whose name starts with the given value are returned.",
                  "key": "starts_with",
                  "value": "<string>"
                },
                {
                  "description": "Cache version timestamp to bypass CDN caching.",
                  "key": "cv",
                  "value": "<integer>"
                }
              ]
            },
            "description": "Returns a list of all tags used in published stories within the space. Tags can be used to filter stories by calling the stories endpoint with the with_tag parameter."
          },
