                  ],
                  "path": [
                    ":asset_path",
                    "m",
                    ""
                  ],
                  "variable": [
                    {
                      "id": "7b6ee71e-2c11-475a-83a4-6c3aaa86a871",
                      "key": "asset_path",
                      "value": "<string>",
                      "description": "(Required) The path portion of the original Storyblok asset CDN URL after the hostname. For example, if the asset URL is https://img2.storyblok.com/f/12345/1200x800/photo.jpg, the asset_path is f/12345/1200x800/photo.jpg."
                    }
                  ]
                },
                "description": "Returns the original image without any transformation. The /m/ path segment activates the Image Service transformation routing for all subsequent operations. Any further path segments after /m/ apply transformations such as resizing, cropping, and filter effects."
