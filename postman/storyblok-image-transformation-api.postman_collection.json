            {
              "name": "Retrieve original image with transformation routing enabled",
              "id": "6eba4068-050e-41a4-8e3f-21f837a669bb",
              "protocolProfileBehavior": {
                "disableBodyPruning": true
              },
              "request": {
                "method": "GET",
                "header": [
