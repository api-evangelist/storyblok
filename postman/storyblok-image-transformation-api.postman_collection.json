                        {
                          "id": "f2d44ae6-e68d-482a-86f2-5d323a058a8f",
                          "key": "asset_path",
                          "value": "<string>",
                          "description": "(Required) The path portion of the original Storyblok asset CDN URL after the hostname. For example, if the asset URL is https://img2.storyblok.com/f/12345/1200x800/photo.jpg, the asset_path is f/12345/1200x800/photo.jpg."
                        }
                      ]
                    },
                    "description": "Returns the image resized to the specified width and height in pixels. If only width is provided (e.g., 500x0), the height is scaled proportionally. If only height is provided (e.g., 0x300), the width is scaled proportionally. Both dimensions set to 0 returns the original size."
