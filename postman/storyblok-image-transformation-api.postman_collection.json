              "name": "{width}x{height}",
              "item": [
                {
                  "name": "filters:{filter_chain}",
                  "item": [
                    {
                      "name": "Transform image with resize and filter chain",
                      "id": "27fd1a09-945a-4eb9-9b4d-963c52d0c41f",
                      "protocolProfileBehavior": {
                        "disableBodyPruning": true
                      },
                      "request": {
                        "method": "GET",
                        "header": [
                          {
                            "key": "Accept",
                            "value": "image/*"
                          }
                        ],
                        "url": {
                          "raw": "{{baseUrl}}/:asset_path/m/{{width}}x{{height}}/filters:{{filter_chain}}",
                          "host": [
                            "{{baseUrl}}"
                          ],
                          "path": [
                            ":asset_path",
                            "m",
                            "{{width}}x{{height}}",
                            "filters:{{filter_chain}}"
                          ],
                          "variable": [
                            {
                              "id": "830e3553-fc04-4944-b1ba-5f1ad761aca9",
                              "key": "asset_path",
                              "value": "<string>",
                              "description": "(Required) The path portion of the original Storyblok asset CDN URL after the hostname. For example, if the asset URL is https://img2.storyblok.com/f/12345/1200x800/photo.jpg, the asset_path is f/12345/1200x800/photo.jpg."
                            }
                          ]
                        },
                        "description": "Returns the image after applying a resize operation and one or more filters. Filters are chained using colons in the filter_chain path segment. Supported filter functions include format(webp|jpeg|png|avif), quality(0-100), fill(color_hex), blur(amount), grayscale(), focal(x:y), rotate(degrees), brightness(amount), and crop(top_left_x, top_left_y, bottom_right_x, bottom_right_y). Multiple filters are separated by colons, for example filters:format(webp):quality(80)."
                      },
                      "response": [
                        {
                          "id": "4dea567d-0a36-423c-93bb-5cc02eaa86ee",
                          "name": "The transformed image was returned successfully.",
                          "originalRequest": {
                            "method": "GET",
                            "header": [
                              {
                                "key": "Accept",
                                "value": "image/*"
                              }
                            ],
                            "url": {
                              "raw": "{{baseUrl}}/:asset_path/m/{{width}}x{{height}}/filters:{{filter_chain}}?token=<API Key>",
                              "host": [
                                "{{baseUrl}}"
                              ],
                              "path": [
                                ":asset_path",
                                "m",
                                "{{width}}x{{height}}",
                                "filters:{{filter_chain}}"
                              ],
                              "query": [
                                {
                                  "description": "Added as a part of security scheme: apikey",
                                  "key": "token",
                                  "value": "<API Key>"
                                }
                              ],
                              "variable": [
                                {
                                  "key": "asset_path"
                                }
                              ]
                            }
                          },
